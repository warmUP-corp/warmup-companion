    {
      "type": "frame",
      "id": "RSveB",
      "x": 968,
      "y": 944,
      "name": "07 Notes · gamepad behaviour and settings mapping",
      "width": 3840,
      "fill": "#141416",
      "cornerRadius": 24,
      "gap": 48,
      "padding": 48,
      "children": [
        {
          "type": "frame",
          "id": "EFVtw",
          "name": "Notes Apps tab (02)",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 10,
          "children": [
            {
              "type": "text",
              "id": "GBDUa",
              "name": "Heading",
              "fill": "$text",
              "content": "Apps tab (02)",
              "fontFamily": "$font",
              "fontSize": 20,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "goEgq",
              "name": "Line 1",
              "fill": "#D8D8DE",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Fifth tab after Controller. LB/RB cycle General → Mouse → Keyboard → Controller → Apps, then the promo card if shown.",
              "lineHeight": 1.45,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "HGwZj",
              "name": "Line 2",
              "fill": "#D8D8DE",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Focus order: Per-app profiles toggle → app rows top to bottom → Add app → Cancel → Apply. Up/Down move, no wrap, same as other tabs.",
              "lineHeight": 1.45,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "zXxVd",
              "name": "Line 3",
              "fill": "#D8D8DE",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "A: flip the toggle / open the focused app / open Add app. B: close the window and discard, as today. Y: reset this tab (profiles on, user apps removed, built-in browser profile back). Staged until Apply.",
              "lineHeight": 1.45,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "S7kIl",
              "name": "Line 4",
              "fill": "#D8D8DE",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Web browsers is one row: the built-in profile covers chrome, msedge, firefox, brave, opera and vivaldi. Off apps show 'Off' and a dimmed name.",
              "lineHeight": 1.45,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "INtpf",
              "name": "Line 5",
              "fill": "#D8D8DE",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Long lists: rows past the hint line scroll with focus; the focused row is always kept fully visible.",
              "lineHeight": 1.45,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "henmP",
          "name": "Notes Profile editor (03)",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 10,
          "children": [
            {
              "type": "text",
              "id": "T8d8o",
              "name": "Heading",
              "fill": "$text",
              "content": "Profile editor (03)",
              "fontFamily": "$font",
              "fontSize": 20,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "yhDoX",
              "name": "Line 1",
              "fill": "#D8D8DE",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "A sub-page of the Apps tab; the Apps tab stays selected in the sidebar.",
              "lineHeight": 1.45,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "Ra69t",
              "name": "Line 2",
              "fill": "#D8D8DE",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Focus order: header (A turns the profile on/off) → button grid row by row → Cancel → Apply. Up/Down move between grid rows, Left/Right between the two columns (like the existing action groups).",
              "lineHeight": 1.45,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "MrNP9",
              "name": "Line 3",
              "fill": "#D8D8DE",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "A on a button tile opens Change action. B goes back to the list (it does not close the window). Y: Reset to built-in for browsers; Remove app for user apps, with the same confirm dialog as Reset all.",
              "lineHeight": 1.45,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "LjJ1q",
              "name": "Line 4",
              "fill": "#D8D8DE",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "LB/RB are ignored while the editor or a dialog is open, so the Tabs hint is hidden.",
              "lineHeight": 1.45,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "C29f6y",
              "name": "Line 5",
              "fill": "#D8D8DE",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Keycaps show the combo. 'Default · Left click' shows the normal Controller Center action. The accent dot marks a button changed from the built-in profile.",
              "lineHeight": 1.45,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "NsJyJ",
          "name": "Notes Dialogs (04–06)",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 10,
          "children": [
            {
              "type": "text",
              "id": "ECyH6",
              "name": "Heading",
              "fill": "$text",
              "content": "Dialogs (04–06)",
              "fontFamily": "$font",
              "fontSize": 20,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "cnMnI",
              "name": "Line 1",
              "fill": "#D8D8DE",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Change action: opens with the current choice focused and checked. Up/Down move, A chooses and closes, B cancels. Presets depend on the app; browsers get tab and navigation shortcuts, other apps get Copy, Paste, Undo, Save, Esc.",
              "lineHeight": 1.45,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "I9Gxvk",
              "name": "Line 2",
              "fill": "#D8D8DE",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Custom key combo: chips → key stepper → Cancel / Use. Left/Right move between chips; A toggles one. On the stepper Left/Right changes the key and wraps. A keyboard key press fills key and modifiers. B goes back to Change action.",
              "lineHeight": 1.45,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "FBCvD",
              "name": "Line 3",
              "fill": "#D8D8DE",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Add app: lists installed apps from the Start menu (all users + current user), A–Z by name; apps that already have a profile are dimmed and skipped. Up/Down move, LB/RB page. A adds the app and opens its editor with every button on Default. 'Type a program name' opens the warmUP keyboard; .exe is added if missing.",
              "lineHeight": 1.45,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "uFSZL",
              "name": "Line 4",
              "fill": "#D8D8DE",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "All dialogs use the existing confirm-dialog style: scrim black 55%, card $tile radius 16, 1px line ring, focused item $hi plus a 2px $ring.",
              "lineHeight": 1.45,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "f8jaIm",
          "name": "Notes settings.ini mapping",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 10,
          "children": [
            {
              "type": "text",
              "id": "Kc3KW",
              "name": "Heading",
              "fill": "$text",
              "content": "settings.ini mapping",
              "fontFamily": "$font",
              "fontSize": 20,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "zOiRP",
              "name": "Line 1",
              "fill": "#D8D8DE",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Button tile → profile.<exe>.<button> = ctrl+w. Default → no line, or 'none' where a built-in mapping exists.",
              "lineHeight": 1.45,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "ooElK",
              "name": "Line 2",
              "fill": "#D8D8DE",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Web browsers row → the same line is written for all six browser exes.",
              "lineHeight": 1.45,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "GIDSC",
              "name": "Line 3",
              "fill": "#D8D8DE",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Reset to built-in / Remove app → delete every profile.<exe>.* line.",
              "lineHeight": 1.45,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "H52Ow",
              "name": "Line 4",
              "fill": "#D8D8DE",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "New keys needed: app_profiles = on|off (tab toggle) and profile.<exe> = off (per-app header toggle). Today's runtime only knows profile.<exe>.<button>.",
              "lineHeight": 1.45,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "sgqKP",
              "name": "Line 5",
              "fill": "#D8D8DE",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Settings import already keeps profile.* lines (fixed on this branch); the two new keys need the same treatment when they're added.",
              "lineHeight": 1.45,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        }
      ]
    }
